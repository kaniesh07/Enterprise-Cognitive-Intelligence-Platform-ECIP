# ─────────────────────────────────────────────────────────────────────────────
# ECIP configuration. Copy to .env and adjust. Every value has a sensible default.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────────────────────
# ollama  → local / self-hosted Ollama (default)
# openai  → any OpenAI-compatible API: OpenAI, Groq, Together, OpenRouter, vLLM,
#           LM Studio, llama.cpp server, Ollama's own /v1 endpoint …
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=llama3.2:3b          # fast on CPU. Better quality: llama3.1:8b, qwen2.5:7b. Tiny: qwen2.5:1.5b
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
MAX_TOKENS=1024
TEMPERATURE=0.3
NUM_CTX=4096                    # Ollama context window (bigger = slower prompt processing)
OLLAMA_KEEP_ALIVE=30m           # keep the model loaded between requests
HISTORY_TURNS=6                 # conversation turns sent to the model

# ── Embeddings ───────────────────────────────────────────────────────────────
# ollama | openai | onnx (local all-MiniLM ONNX dir) | hash (no model, testing only)
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text    # with openai: text-embedding-3-small
# ONNX_MODEL_DIR=./models/minilm

# ── Auth: "key:role,key:role"  roles: reader < writer < admin ─────────────────
API_KEYS=ecip-dev-key:admin,reader-key:reader,writer-key:writer
# GRAFANA_URL=https://ecip-monitoring.example.com   # Grafana link shown in the chat page on every device
# PUBLIC_ROLE=reader            # visitors without a key may chat/search (uploads still need a writer/admin key)

# ── Vector DB ────────────────────────────────────────────────────────────────
# Empty CHROMA_HOST = embedded on-disk Chroma in DATA_DIR (no server needed).
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_COLLECTION=ecip_documents

# ── Retrieval / routing ──────────────────────────────────────────────────────
TOP_K_FINAL=4
MAX_CONTEXT_CHARS=4500          # cap on source text sent to the LLM (lower = faster first token)
CHUNK_SIZE=300
CHUNK_OVERLAP=60
RERANK_ENABLED=false            # cross-encoder rerank (needs requirements-extras, adds latency)
# MIN_DENSE_SCORE=0.6           # auto-mode relevance bar (default depends on embedding model)
MIN_LEXICAL_OVERLAP=0.34
VERIFIER_MODE=heuristic         # heuristic (fast) | llm (2nd LLM pass) | off
INSTANT_SMALLTALK=true          # answer "hi"/"thanks" instantly without the LLM

# ── Guardrails ───────────────────────────────────────────────────────────────
GUARDRAIL_RATE_LIMIT=true
RATE_LIMIT_RPM=60
RATE_LIMIT_RPH=1000
RATE_LIMIT_BURST=10
REDACT_PII=true
FAITHFULNESS_THRESHOLD=0.35

# ── Storage / server ─────────────────────────────────────────────────────────
DATA_DIR=./data
PORT=8000
LOG_LEVEL=INFO
# LOG_FORMAT=json
CORS_ORIGINS=*
SERVE_FRONTEND=true
MAX_UPLOAD_MB=50

# ── Ingestion ────────────────────────────────────────────────────────────────
INGEST_WORKERS=4
MAX_DOC_SIZE_MB=100
USE_DOCLING=false
# CELERY_BROKER_URL=redis://localhost:6379/0

# ── Monitoring (docker compose) ──────────────────────────────────────────────
GRAFANA_PASSWORD=ecip-admin
FLOWER_USER=admin
FLOWER_PASS=ecip-flower
